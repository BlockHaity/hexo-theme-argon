<%
	let archive_name = "";
	let archive_title = "";
	let archive_count = -1;
	// 卡片内的统计图标与统计文案
	let archive_icon = "fa-file-o";
	let archive_count_html = "";
	// 标题后是否追加「 : 标题」（归档/标签页/分类页为 true，标签索引页/分类索引页为 false）
	let has_title = true;
	// 是否输出整张信息卡片，只有标签索引页/分类索引页可以关闭
	let show_card = true;
	if (is_tag()){
		archive_name = "标签";
		archive_title = page.tag;
		archive_count = site.tags.findOne({name: page.tag}).length;
	}
	if (is_category()){
		archive_name = "分类";
		archive_title = page.category;
		archive_count = site.categories.findOne({name: page.category}).length;
	}
	if (is_archive()){
		archive_name = "归档";
		archive_title = page.year + (page.month == undefined ? '' : '/' + page.month);
	}
	if (archive_count != -1 && archive_count_html == ''){
		archive_count_html = archive_count + " 篇文章";
	}
	if (page.argon_taxonomy_index != undefined){
		// 标签索引页/分类索引页：统计的是站点真实总数，不受 limit 影响
		const taxonomy_cfg = argon_taxonomy_config(page.argon_taxonomy_index);
		show_card = taxonomy_cfg.show_card;
		has_title = false;
		if (page.argon_taxonomy_index == 'category'){
			archive_name = "分类";
			archive_icon = "fa-folder-open";
			archive_count_html = "共 " + site.categories.length + " 个分类 · " + site.posts.length + " 篇文章";
		} else {
			archive_name = "标签";
			archive_icon = "fa-tags";
			archive_count_html = "共 " + site.tags.length + " 个标签 · " + site.posts.length + " 篇文章";
		}
	}
%>
<% if (show_card) { %><div class="page-information-card card bg-gradient-secondary shadow-lg border-0">
	<div class="card-body">
		<h3 class="text-black"><%= has_title ? (archive_name + ' : ' + archive_title + ' ') : archive_name %></h3>
		<% if (archive_count_html != ''){ %>
			<p class="text-black mt-3 mb-0 opacity-8">
				<i class="fa <%= archive_icon %> mr-1"></i>
				<%= archive_count_html %>
			</p>
		<% } %>
	</div>
</div><% } %>
